<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TelemetrySimulator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MQTT client — simulates the ESP32 publishing over MQTT (port 1883). -->
    <PackageReference Include="MQTTnet" Version="4.3.*" />
  </ItemGroup>

</Project>
