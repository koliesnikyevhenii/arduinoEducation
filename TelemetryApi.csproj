<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cb6c3fbd-66ff-41fb-8abe-b33215dc9b67</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The simulator is a separate console project; don't compile it into the API.
         (Sdk.Web globs all *.cs under the project dir recursively by default.) -->
    <Compile Remove="simulator/**/*.cs" />
    <Content Remove="simulator/**/*" />
    <None Remove="simulator/**/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- PostgreSQL provider for EF Core -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.*" />
    <!-- migrations / dotnet ef -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- snake_case naming convention for tables/columns -->
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.*" />
    <!-- RabbitMQ client (7.x is async-first) -->
    <PackageReference Include="RabbitMQ.Client" Version="7.*" />
    <!-- Swagger for trying the API while there is no frontend yet -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
  </ItemGroup>

</Project>
